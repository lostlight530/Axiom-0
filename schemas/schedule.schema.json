{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lostlight530.github.io/Axiom-0/schemas/schedule.schema.json",
  "title": "Axiom schedule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "enabled", "owner", "trigger", "execution", "permissions", "artifacts", "failure"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "enabled": {"type": "boolean"},
    "owner": {"type": "string", "minLength": 1},
    "trigger": {"type": "object", "additionalProperties": false, "required": ["kind", "expression", "timezone"], "properties": {"kind": {"const": "cron"}, "expression": {"type": "string", "minLength": 9}, "timezone": {"const": "UTC"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["command", "timeout_seconds", "concurrency_group", "cancel_in_progress"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "concurrency_group": {"type": "string", "minLength": 1}, "cancel_in_progress": {"type": "boolean"}}},
    "permissions": {"type": "object"},
    "artifacts": {"type": "array"},
    "failure": {"type": "object"}
  }
}